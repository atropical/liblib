{
  "name": "@atropical/liblib",
  "version": "0.1.0",
  "description": "Typed reader for LibLib design-system and usage snapshots, with a schema guard that throws instead of returning plausible empties.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Atropical AS",
  "keywords": [
    "figma",
    "design system",
    "design tokens",
    "toon",
    "snapshot",
    "diff",
    "agents",
    "llm"
  ],
  "homepage": "https://github.com/atropical/liblib/tree/main/packages/reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atropical/liblib.git",
    "directory": "packages/reader"
  },
  "bugs": "https://github.com/atropical/liblib/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "liblib": "./dist/cli.js"
  },
  "files": ["dist", "SKILL.md", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm run types && npm test",
    "types": "tsc -p tsconfig.json && tsc ../core/src/types.ts --ignoreConfig --declaration --emitDeclarationOnly --target esnext --module esnext --outDir dist && node scripts/finish-types.mjs",
    "tsc": "tsc -p tsconfig.json --noEmit --declaration false --emitDeclarationOnly false",
    "fixtures": "esbuild scripts/make-fixtures.ts --bundle --platform=node --format=esm --external:@toon-format/toon --outfile=node_modules/.cache/make-fixtures.mjs && node node_modules/.cache/make-fixtures.mjs",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@toon-format/toon": "^4.1.0"
  },
  "devDependencies": {
    "@atropical/liblib-core": "*",
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
