{
  "name": "liblib",
  "private": true,
  "description": "Workspace root. The Figma plugin lives in packages/plugin, the code it shares with the reader in packages/core, and the published reader in packages/reader.",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @atropical/liblib-plugin",
    "dev": "npm run dev -w @atropical/liblib-plugin",
    "test": "npm run test --workspaces --if-present",
    "tsc": "npm run tsc --workspaces --if-present",
    "calibrate:tokens": "npm run calibrate:tokens -w @atropical/liblib-plugin",
    "fixtures": "npm run fixtures -w @atropical/liblib-plugin",
    "version:bump:patch": "npm run version:bump:patch -w @atropical/liblib-plugin",
    "version:bump:minor": "npm run version:bump:minor -w @atropical/liblib-plugin",
    "version:bump:major": "npm run version:bump:major -w @atropical/liblib-plugin"
  },
  "author": "Atropical AS",
  "license": "GPL-3.0-only"
}
